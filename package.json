{
  "name": "acfun-svfeed",
  "version": "0.9.70",
  "description": "AcFun PC 站抖音式竖滑页油猴脚本：小视频(meow) + APP 首页推荐双源，弹幕/清晰度/收藏投蕉（源码在 src/，构建产物为单文件 .user.js）",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "release": "npm version patch && node build.js",
    "test": "npm run test:unit && node test/run-harness.mjs",
    "test:unit": "node --test test/unit/",
    "test:harness": "node test/run-harness.mjs",
    "lint": "eslint src build.js test/unit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "playwright": "^1.49.0"
  },
  "author": "name-xxl",
  "license": "MIT",
  "dependencies": {
    "hls.js": "1.5.20"
  }
}
